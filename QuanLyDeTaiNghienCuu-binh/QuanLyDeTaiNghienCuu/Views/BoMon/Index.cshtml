@model QuanLyDeTaiNghienCuu.Models.ViewModels.BoMonIndexViewModel
@{
    ViewData["Title"] = "Quản lý bộ môn";
}

<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title"><i class="fa-solid fa-building-columns me-2"></i>Quản Lý Bộ Môn</h1>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-action="Create" class="btn btn-light btn-lg px-4 rounded-pill shadow-sm">
                <i class="fa-solid fa-circle-plus me-2 text-primary"></i>Thêm bộ môn
            </a>
        </div>
    </div>
</div>

<div class="filter-card">
    <form asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label-custom"><i class="fa-solid fa-magnifying-glass me-1 text-primary"></i>Từ khóa</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-custom" placeholder="Tên bộ môn hoặc email liên hệ..." />
            </div>
            <div class="col-md-3">
                <label class="form-label-custom">Trạng thái</label>
                <select name="trangThai" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    <option value="active" selected="@(Model.TrangThai == "active")">Hoạt động</option>
                    <option value="inactive" selected="@(Model.TrangThai == "inactive")">Tạm dừng</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-fill"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-custom flex-fill"><i class="fa-solid fa-rotate-left me-1"></i>Đặt lại</a>
            </div>
        </div>
    </form>
</div>

<div class="filter-card">
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted small">Tìm thấy <strong>@Model.TotalItems</strong> bộ môn</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th>Tên bộ môn</th>
                    <th>Email liên hệ</th>
                    <th class="text-center">Số đề tài</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:260px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Không có bộ môn nào phù hợp.</td></tr>
            }
            @{ var stt = (Model.Page - 1) * Model.PageSize; }
            @foreach (var b in Model.Items)
            {
                stt++;
                <tr>
                    <td>@stt</td>
                    <td>
                        <div class="fw-semibold">@b.TenBoMon</div>
                        @if (!string.IsNullOrWhiteSpace(b.MoTa))
                        {
                            <div class="text-muted small text-truncate" style="max-width:420px">@b.MoTa</div>
                        }
                    </td>
                    <td>@(b.EmailLienHe ?? "—")</td>
                    <td class="text-center"><span class="badge bg-secondary-subtle text-secondary">@b.SoDeTai</span></td>
                    <td class="text-center">
                        @if (b.TrangThai)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Tạm dừng</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Details" asp-route-id="@b.MaBoMon" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@b.MaBoMon" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="ToggleStatus" asp-route-id="@b.MaBoMon" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="@(b.TrangThai ? "Tạm dừng" : "Kích hoạt")">
                                    <i class="fa-solid @(b.TrangThai ? "fa-pause" : "fa-play")"></i>
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@b.MaBoMon" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="new PagerModel { Page = Model.Page, TotalPages = Model.TotalPages }" />
</div>
