@model QuanLyDeTaiNghienCuu.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="filter-card mt-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-graduation-cap fa-3x text-primary mb-2"></i>
                <h4 class="fw-bold mb-0">Đăng nhập hệ thống</h4>
                <p class="text-muted small mb-0">Quản lý đề tài NCKH &amp; đăng ký đề tài sinh viên</p>
            </div>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                @if ((ViewData.ModelState[string.Empty]?.Errors.Count ?? 0) > 0)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        @Html.ValidationSummary(true, "", new { @class = "d-inline" })
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label-custom">Đăng nhập với tư cách</label>
                    <div class="btn-group w-100" role="group">
                        @foreach (var r in Roles.All)
                        {
                            <input type="radio" class="btn-check" asp-for="VaiTro" value="@r" id="role_@r" autocomplete="off" />
                            <label class="btn btn-outline-primary" for="role_@r">@Roles.ToDisplay(r)</label>
                        }
                    </div>
                    <span asp-validation-for="VaiTro" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label-custom"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        <input asp-for="TenDangNhap" class="form-control form-control-custom" autofocus autocomplete="username" />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MatKhau" class="form-label-custom"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="MatKhau" class="form-control form-control-custom" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                </button>
            </form>

            <div class="text-center mt-3 small">
                Chưa có tài khoản? <a asp-action="Register">Đăng ký sinh viên</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
