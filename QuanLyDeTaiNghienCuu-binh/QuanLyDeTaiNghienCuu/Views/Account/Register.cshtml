@model QuanLyDeTaiNghienCuu.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="filter-card mt-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-user-plus fa-3x text-primary mb-2"></i>
                <h4 class="fw-bold mb-0">Đăng ký tài khoản sinh viên</h4>
                <p class="text-muted small mb-0">Chỉ dành cho sinh viên. Tài khoản Giảng viên và Admin do quản trị viên cấp.</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label-custom"></label>
                    <input asp-for="HoTen" class="form-control form-control-custom" autofocus />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label-custom"></label>
                    <input asp-for="TenDangNhap" class="form-control form-control-custom" autocomplete="username" />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label-custom"></label>
                    <input asp-for="Email" type="email" class="form-control form-control-custom" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label-custom"></label>
                    <input asp-for="MatKhau" class="form-control form-control-custom" autocomplete="new-password" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="XacNhanMatKhau" class="form-label-custom"></label>
                    <input asp-for="XacNhanMatKhau" class="form-control form-control-custom" autocomplete="new-password" />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100">
                    <i class="fa-solid fa-user-check me-1"></i> Đăng ký
                </button>
            </form>

            <div class="text-center mt-3 small">
                Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
