@using QuanLyDeTaiNghienCuu.Helpers
@model QuanLyDeTaiNghienCuu.Models.TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
    var reason = ViewBag.DeleteBlockedReason as string;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="filter-card">
            <h4 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-user-xmark me-2"></i>Xóa tài khoản</h4>

            @if (reason != null)
            {
                <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>@reason</div>
            }
            else
            {
                <p>Bạn có chắc chắn muốn xóa tài khoản <strong>@Model.TenDangNhap</strong>? Thao tác này không thể hoàn tác.</p>
            }

            <dl class="row">
                <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
                <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@Roles.ToDisplay(Model.VaiTro)</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" method="post" class="d-flex gap-2">
                @if (reason == null)
                {
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Xác nhận xóa</button>
                }
                <a asp-action="Index" class="btn btn-outline-custom">Quay lại</a>
            </form>
        </div>
    </div>
</div>
