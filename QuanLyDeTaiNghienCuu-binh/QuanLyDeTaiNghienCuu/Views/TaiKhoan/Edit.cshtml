@model QuanLyDeTaiNghienCuu.Models.ViewModels.TaiKhoanFormViewModel
@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="filter-card">
            <h4 class="fw-bold mb-4"><i class="fa-solid fa-user-pen me-2 text-primary"></i>Sửa tài khoản</h4>
            <form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post">
                <input type="hidden" asp-for="MaTaiKhoan" />
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button>
                    <a asp-action="Index" class="btn btn-outline-custom">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
