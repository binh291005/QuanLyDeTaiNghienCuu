@using QuanLyDeTaiNghienCuu.Helpers
@model QuanLyDeTaiNghienCuu.Models.ViewModels.TaiKhoanIndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var currentId = Context.Session.GetMaTaiKhoan();
    var roleList = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.RoleList;
}

<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title"><i class="fa-solid fa-users-gear me-2"></i>Quản Lý Tài Khoản</h1>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-action="Create" class="btn btn-light btn-lg px-4 rounded-pill shadow-sm">
                <i class="fa-solid fa-user-plus me-2 text-primary"></i>Thêm tài khoản
            </a>
        </div>
    </div>
</div>

<div class="filter-card">
    <form asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label-custom"><i class="fa-solid fa-magnifying-glass me-1 text-primary"></i>Từ khóa</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-custom" placeholder="Tên đăng nhập, họ tên, email..." />
            </div>
            <div class="col-md-3">
                <label class="form-label-custom">Vai trò</label>
                <select name="vaiTro" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    @foreach (var r in roleList)
                    {
                        <option value="@r.Value" selected="@(Model.VaiTro == r.Value)">@r.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label-custom">Trạng thái</label>
                <select name="trangThai" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    <option value="active" selected="@(Model.TrangThai == "active")">Hoạt động</option>
                    <option value="locked" selected="@(Model.TrangThai == "locked")">Bị khóa</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-fill"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-custom flex-fill"><i class="fa-solid fa-rotate-left me-1"></i>Đặt lại</a>
            </div>
        </div>
    </form>
</div>

<div class="filter-card">
    <div class="mb-2 text-muted small">Tìm thấy <strong>@Model.TotalItems</strong> tài khoản</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:240px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có tài khoản nào phù hợp.</td></tr>
            }
            @{ var stt = (Model.Page - 1) * Model.PageSize; }
            @foreach (var t in Model.Items)
            {
                stt++;
                var isSelf = currentId == t.MaTaiKhoan;
                <tr>
                    <td>@stt</td>
                    <td class="fw-semibold">@t.TenDangNhap @if (isSelf) { <span class="badge bg-info-subtle text-info-emphasis ms-1">Bạn</span> }</td>
                    <td>@t.HoTen</td>
                    <td>@t.Email</td>
                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Roles.ToDisplay(t.VaiTro)</span></td>
                    <td class="text-center">
                        @if (t.TrangThai)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Bị khóa</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Details" asp-route-id="@t.MaTaiKhoan" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@t.MaTaiKhoan" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="ToggleStatus" asp-route-id="@t.MaTaiKhoan" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="@(t.TrangThai ? "Khóa" : "Mở khóa")">
                                    <i class="fa-solid @(t.TrangThai ? "fa-lock" : "fa-lock-open")"></i>
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@t.MaTaiKhoan" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="new PagerModel { Page = Model.Page, TotalPages = Model.TotalPages }" />
</div>
