@*
Họ và tên: [ĐIỀN HỌ TÊN]
Mã sinh viên: [ĐIỀN MÃ SINH VIÊN]
Nội dung thực hiện: Module 4 - Tiếp nhận, xét duyệt và quản lý trạng thái hồ sơ đăng ký đề tài.
*@
@model QuanLyDeTaiNghienCuu.Models.HoSoDangKyDeTai
@{
    ViewData["Title"] = "Chi tiết hồ sơ";
    var soDaGiao = (int)(ViewBag.SoNhomDaDuocGiao ?? 0);
    var soToiDa = (int)(ViewBag.SoNhomToiDa ?? 0);
    var coTheXetDuyet = (bool)(ViewBag.CoTheXetDuyet ?? false);
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
        <h2 class="fw-bold mt-2 mb-1">Hồ sơ #@Model.MaHoSo</h2>
        <p class="text-muted mb-0">Thông tin chi tiết hồ sơ đăng ký đề tài.</p>
    </div>
    @if (coTheXetDuyet)
    {
        <a asp-action="Review" asp-route-id="@Model.MaHoSo" class="btn btn-primary-custom">
            <i class="fa-solid fa-check-double me-1"></i>Xét duyệt hồ sơ
        </a>
    }
</div>

@if (soToiDa > 0 && soDaGiao >= soToiDa)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-3">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        Đề tài này đã đạt số nhóm tối đa: <strong>@soDaGiao/@soToiDa</strong>. Không tự động xóa các hồ sơ còn lại; giảng viên cần xem xét đóng đề tài nếu phù hợp.
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-user-graduate text-primary me-2"></i>Thông tin sinh viên</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Họ tên</dt><dd class="col-sm-8 fw-semibold">@Model.SinhVien?.HoTen</dd>
                    <dt class="col-sm-4 text-muted">Email</dt><dd class="col-sm-8">@(Model.SinhVien?.Email ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Ngành</dt><dd class="col-sm-8">@(Model.SinhVien?.Nganh ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">ĐTB</dt><dd class="col-sm-8">@(Model.SinhVien?.DiemTrungBinh?.ToString("0.00") ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Lĩnh vực quan tâm</dt><dd class="col-sm-8">@(Model.SinhVien?.LinhVucQuanTam ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Hoạt động</dt><dd class="col-sm-8">@(Model.SinhVien?.TrangThai == true ? "Có" : "Không")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-flask text-primary me-2"></i>Thông tin đề tài</h5>
                <p class="fw-bold mb-2">@Model.DeTai?.TenDeTai</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Bộ môn</dt><dd class="col-sm-8">@(Model.DeTai?.BoMon?.TenBoMon ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">Lĩnh vực</dt><dd class="col-sm-8">@(Model.DeTai?.LinhVucNghienCuu ?? "-")</dd>
                    <dt class="col-sm-4 text-muted">ĐTB tối thiểu</dt><dd class="col-sm-8">@(Model.DeTai == null ? "-" : Model.DeTai.DiemTrungBinhToiThieu.ToString("0.00"))</dd>
                    <dt class="col-sm-4 text-muted">Số nhóm</dt><dd class="col-sm-8"><strong>@soDaGiao/@soToiDa</strong> đã được giao</dd>
                    <dt class="col-sm-4 text-muted">Yêu cầu</dt><dd class="col-sm-8">@(Model.DeTai?.YeuCauSinhVien ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-file-lines text-primary me-2"></i>Nội dung hồ sơ</h5>
                    <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill">@Model.TrangThai</span>
                </div>
                <div class="row g-4">
                    <div class="col-md-6"><div class="info-box h-100"><strong>Ngày nộp</strong><div class="mt-2">@Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</div></div></div>
                    <div class="col-md-6"><div class="info-box h-100"><strong>Ngày xử lý</strong><div class="mt-2">@(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xử lý")</div></div></div>
                    <div class="col-md-6"><div class="info-box h-100"><strong>Đề cương sơ bộ</strong><div class="mt-2" style="white-space: pre-line">@(Model.DeCuongSoBo ?? "Chưa có")</div></div></div>
                    <div class="col-md-6"><div class="info-box h-100"><strong>Ghi chú của sinh viên</strong><div class="mt-2" style="white-space: pre-line">@(Model.GhiChu ?? "Không có")</div></div></div>
                    <div class="col-12"><div class="info-box"><strong>Nhận xét xét duyệt</strong><div class="mt-2" style="white-space: pre-line">@(Model.NhanXetXetDuyet ?? "Chưa có nhận xét")</div></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
