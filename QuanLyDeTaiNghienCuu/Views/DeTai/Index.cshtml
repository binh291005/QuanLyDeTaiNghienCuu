@model QuanLyDeTaiNghienCuu.Models.ViewModels.DeTaiIndexViewModel

@{
    ViewData["Title"] = "Quản Lý Đề Tài NCKH";
}

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title">
                <i class="fa-solid fa-folder-open me-2"></i>Quản Lý Đề Tài Nghiên Cứu Khoa Học
            </h1>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-action="Create" class="btn btn-light btn-lg font-weight-bold px-4 rounded-pill shadow-sm">
                <i class="fa-solid fa-circle-plus me-2 text-primary"></i>Thêm Đề Tài Mới
            </a>
        </div>
    </div>
</div>

<!-- Search & Filter Toolbar Card -->
<div class="filter-card">
    <form asp-action="Index" method="get" id="filterForm">
        <div class="row g-3">
            <!-- Search Keyword Input -->
            <div class="col-md-4">
                <label class="form-label-custom">
                    <i class="fa-solid fa-magnifying-glass me-1 text-primary"></i>Từ khóa tìm kiếm
                </label>
                <div class="input-group">
                    <input type="text" asp-for="SearchTerm" class="form-control form-control-custom"
                           placeholder="Nhập tên đề tài hoặc bộ môn..." />
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary d-flex align-items-center" title="Xóa từ khóa">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Department Filter -->
            <div class="col-md-3">
                <label class="form-label-custom">
                    <i class="fa-solid fa-building-columns me-1 text-primary"></i>Bộ môn
                </label>
                <select asp-for="MaBoMon" asp-items="Model.BoMonList" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả bộ môn --</option>
                </select>
            </div>

            <!-- Research Field Filter -->
            <div class="col-md-3">
                <label class="form-label-custom">
                    <i class="fa-solid fa-microscope me-1 text-primary"></i>Lĩnh vực nghiên cứu
                </label>
                <select asp-for="LinhVuc" asp-items="Model.LinhVucList" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả lĩnh vực --</option>
                </select>
            </div>

            <!-- Status Filter -->
            <div class="col-md-2">
                <label class="form-label-custom">
                    <i class="fa-solid fa-toggle-on me-1 text-primary"></i>Trạng thái
                </label>
                <select asp-for="TrangThai" asp-items="Model.TrangThaiList" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <!-- Registration Deadline Filter -->
            <div class="col-md-3">
                <label class="form-label-custom">
                    <i class="fa-solid fa-calendar-check me-1 text-primary"></i>Hạn đăng ký
                </label>
                <select asp-for="ConHan" asp-items="Model.ConHanList" class="form-select form-select-custom" onchange="this.form.submit()">
                </select>
            </div>

            <!-- Min Grade Threshold Filter -->
            <div class="col-md-3">
                <label class="form-label-custom">
                    <i class="fa-solid fa-chart-line me-1 text-primary"></i>Mức ĐTB tối thiểu (<=)
                </label>
                <select asp-for="MinDtb" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="">-- Tất cả mức điểm --</option>
                    <option value="2.0">Yêu cầu ĐTB <= 2.0</option>
                    <option value="2.5">Yêu cầu ĐTB <= 2.5</option>
                    <option value="3.0">Yêu cầu ĐTB <= 3.0</option>
                    <option value="3.5">Yêu cầu ĐTB <= 3.5</option>
                </select>
            </div>

            <!-- Sort By Select -->
            <div class="col-md-4">
                <label class="form-label-custom">
                    <i class="fa-solid fa-arrow-down-wide-short me-1 text-primary"></i>Sắp xếp theo
                </label>
                <select asp-for="SortBy" asp-items="Model.SortByList" class="form-select form-select-custom" onchange="this.form.submit()">
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary-custom w-100">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary form-control-custom d-flex align-items-center justify-content-center" title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Header Stats & Result Summary -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa-solid fa-list-check me-2 text-primary"></i>Danh Sách Đề Tài
        </h4>
        <span class="text-muted fs-6">
            Hiển thị <strong>@Model.Items.Count</strong> / <strong>@Model.TotalItems</strong> đề tài thỏa mãn điều kiện lọc.
        </span>
    </div>

    <!-- Active Filters Badge Summary -->
    <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                <i class="fa-solid fa-magnifying-glass me-1"></i>"@Model.SearchTerm"
            </span>
        }
        @if (Model.MaBoMon.HasValue)
        {
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                <i class="fa-solid fa-building-columns me-1"></i>Bộ môn ID: @Model.MaBoMon
            </span>
        }
        @if (!string.IsNullOrEmpty(Model.LinhVuc))
        {
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                <i class="fa-solid fa-tag me-1"></i>@Model.LinhVuc
            </span>
        }
        @if (!string.IsNullOrEmpty(Model.TrangThai))
        {
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                <i class="fa-solid fa-flag me-1"></i>@Model.TrangThai
            </span>
        }
    </div>
</div>

<!-- Topics Grid Cards -->
@if (Model.Items != null && Model.Items.Count > 0)
{
    <div class="row g-4 mb-4">
        @foreach (var item in Model.Items)
        {
            var deTai = item.DeTai;
            string statusClass = deTai.TrangThai switch
            {
                "Đang mở đăng ký" => "badge-status-dang-mo",
                "Chưa mở" => "badge-status-chua-mo",
                "Tạm dừng" => "badge-status-tam-dung",
                "Đã đóng" => "badge-status-da-dong",
                _ => "badge-status-chua-mo"
            };

            <div class="col-lg-4 col-md-6">
                <div class="topic-card">
                    <!-- Top Status & Department Badges -->
                    <div class="topic-card-header">
                        <span class="badge badge-custom @statusClass">
                            <i class="fa-solid fa-circle text-xs"></i> @deTai.TrangThai
                        </span>

                        <span class="badge badge-custom badge-department" title="Bộ môn">
                            <i class="fa-solid fa-building-columns me-1"></i> @(deTai.BoMon?.TenBoMon ?? "N/A")
                        </span>
                    </div>

                    <!-- Card Body -->
                    <div class="topic-card-body">
                        <a asp-action="Details" asp-route-id="@deTai.MaDeTai" class="topic-title">
                            @deTai.TenDeTai
                        </a>

                        <div class="mb-3">
                            <span class="badge badge-custom badge-field me-1 mb-1">
                                <i class="fa-solid fa-tag me-1"></i> @deTai.LinhVucNghienCuu
                            </span>
                        </div>

                        <!-- Date range notice for students -->
                        <div class="info-box mb-3 py-2 px-3">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span class="text-muted"><i class="fa-regular fa-clock me-1"></i>Nhận hồ sơ:</span>
                                <span class="fw-semibold">@deTai.NgayBatDauDangKy.ToString("dd/MM/yyyy") - @deTai.HanDangKy.ToString("dd/MM/yyyy")</span>
                            </div>

                            @if (item.IsRegistrationOpenNow)
                            {
                                <div class="text-success small fw-bold d-flex align-items-center">
                                    <i class="fa-solid fa-circle-check me-1"></i> Đang trong thời gian nộp hồ sơ
                                </div>
                            }
                            else if (deTai.IsExpired)
                            {
                                <div class="text-danger small fw-semibold d-flex align-items-center">
                                    <i class="fa-solid fa-calendar-xmark me-1"></i> Đã hết hạn đăng ký
                                </div>
                            }
                            else if (deTai.IsNotStarted)
                            {
                                <div class="text-warning small fw-semibold d-flex align-items-center">
                                    <i class="fa-regular fa-hourglass-half me-1"></i> Chưa đến ngày mở đăng ký
                                </div>
                            }
                        </div>

                        <!-- Requirements summary -->
                        <div class="row g-2 text-muted small mt-auto">
                            <div class="col-6">
                                <i class="fa-solid fa-users me-1 text-primary"></i>Nhóm tối đa: <strong>@deTai.SoNhomToiDa</strong>
                            </div>
                            <div class="col-6">
                                <i class="fa-solid fa-star me-1 text-warning"></i>ĐTB tối thiểu: <strong>@deTai.DiemTrungBinhToiThieu.ToString("0.0")</strong>
                            </div>
                            <div class="col-12">
                                <i class="fa-solid fa-file-signature me-1 text-info"></i>Số hồ sơ: <strong>@item.TotalHoSoCount</strong> (Đã giao: <strong>@item.AssignedHoSoCount</strong>)
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer Actions -->
                    <div class="topic-card-footer">
                        <div class="d-flex align-items-center gap-1">
                            <a asp-action="Details" asp-route-id="@deTai.MaDeTai" class="btn btn-sm btn-outline-custom" title="Xem chi tiết">
                                <i class="fa-solid fa-eye me-1"></i>Chi tiết
                            </a>
                            <a asp-action="Edit" asp-route-id="@deTai.MaDeTai" class="btn btn-sm btn-outline-primary" title="Sửa đề tài">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                            </a>
                        </div>

                        <!-- Dropdown quick change status -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-gear text-secondary"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><h6 class="dropdown-header">Đổi nhanh trạng thái</h6></li>
                                <li>
                                    <form asp-action="QuickChangeStatus" method="post">
                                        <input type="hidden" name="id" value="@deTai.MaDeTai" />
                                        <input type="hidden" name="newStatus" value="Đang mở đăng ký" />
                                        <button type="submit" class="dropdown-item text-success"><i class="fa-solid fa-play me-2"></i>Đang mở đăng ký</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-action="QuickChangeStatus" method="post">
                                        <input type="hidden" name="id" value="@deTai.MaDeTai" />
                                        <input type="hidden" name="newStatus" value="Tạm dừng" />
                                        <button type="submit" class="dropdown-item text-warning"><i class="fa-solid fa-pause me-2"></i>Tạm dừng</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-action="QuickChangeStatus" method="post">
                                        <input type="hidden" name="id" value="@deTai.MaDeTai" />
                                        <input type="hidden" name="newStatus" value="Đã đóng" />
                                        <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-lock me-2"></i>Đã đóng</button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a asp-action="Delete" asp-route-id="@deTai.MaDeTai" class="dropdown-item text-danger fw-semibold">
                                        <i class="fa-solid fa-trash me-2"></i>Xóa đề tài
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls preserving search, filter, and sort state -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 border-top">
        <div class="text-muted small mb-2 mb-md-0">
            Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong> (Tổng <strong>@Model.TotalItems</strong> đề tài)
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination pagination-custom mb-0">
                <!-- First Page -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-maBoMon="@Model.MaBoMon"
                       asp-route-linhVuc="@Model.LinhVuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-minDtb="@Model.MinDtb"
                       asp-route-conHan="@Model.ConHan"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="1"
                       title="Trang đầu">
                        <i class="fa-solid fa-angles-left"></i>
                    </a>
                </li>

                <!-- Previous Page -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-maBoMon="@Model.MaBoMon"
                       asp-route-linhVuc="@Model.LinhVuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-minDtb="@Model.MinDtb"
                       asp-route-conHan="@Model.ConHan"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="@(Model.PageIndex - 1)">
                        <i class="fa-solid fa-chevron-left me-1"></i>Trước
                    </a>
                </li>

                <!-- Page Number Links -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-maBoMon="@Model.MaBoMon"
                           asp-route-linhVuc="@Model.LinhVuc"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-minDtb="@Model.MinDtb"
                           asp-route-conHan="@Model.ConHan"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <!-- Next Page -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-maBoMon="@Model.MaBoMon"
                       asp-route-linhVuc="@Model.LinhVuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-minDtb="@Model.MinDtb"
                       asp-route-conHan="@Model.ConHan"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="@(Model.PageIndex + 1)">
                        Sau<i class="fa-solid fa-chevron-right ms-1"></i>
                    </a>
                </li>

                <!-- Last Page -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-maBoMon="@Model.MaBoMon"
                       asp-route-linhVuc="@Model.LinhVuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-minDtb="@Model.MinDtb"
                       asp-route-conHan="@Model.ConHan"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="@Model.TotalPages"
                       title="Trang cuối">
                        <i class="fa-solid fa-angles-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
else
{
    <!-- Empty State View -->
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <div class="mb-3">
                <i class="fa-solid fa-folder-open text-muted opacity-50" style="font-size: 4rem;"></i>
            </div>
            <h5 class="fw-bold text-secondary">Không tìm thấy đề tài nào phù hợp!</h5>
            <p class="text-muted">Vui lòng thử thay đổi từ khóa tìm kiếm hoặc đặt lại các bộ lọc.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fa-solid fa-arrows-rotate me-1"></i>Đặt lại bộ lọc
            </a>
        </div>
    </div>
}
