@model QuanLyDeTaiNghienCuu.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var cacChiSo = new List<(string Nhan, int GiaTri, string Icon)>
    {
        ("Tổng số bộ môn", Model.TongBoMon, "fa-building-columns"),
        ("Tổng số đề tài", Model.TongDeTai, "fa-book"),
        ("Đề tài đang mở đăng ký", Model.DeTaiDangMo, "fa-door-open"),
        ("Tổng số sinh viên", Model.TongSinhVien, "fa-user-graduate"),
        ("Tổng số hồ sơ", Model.TongHoSo, "fa-folder-open"),
        ("Hồ sơ chờ duyệt", Model.HoSoChoDuyet, "fa-hourglass-half"),
        ("Hồ sơ đạt xét duyệt", Model.HoSoDatXetDuyet, "fa-circle-check"),
        ("Lịch bảo vệ sắp tới", Model.LichSapToi, "fa-calendar-days"),
        ("Hồ sơ được giao đề tài", Model.HoSoDuocGiao, "fa-award")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="fa-solid fa-chart-pie me-2"></i>Dashboard</h3>
    <a asp-action="Index" class="btn btn-outline-primary">Xem thống kê chi tiết</a>
</div>

<div class="row g-3">
    @foreach (var c in cacChiSo)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fa-solid @c.Icon fs-2 text-primary me-3"></i>
                    <div>
                        <div class="text-muted small">@c.Nhan</div>
                        <div class="fs-3 fw-bold">@c.GiaTri</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
